{
  "display_information": {
    "name": "Remove Messages",
    "description": "Delete your own recent messages in the current conversation",
    "background_color": "#2c2d30"
  },
  "features": {
    "bot_user": {
      "display_name": "Remove Messages",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/delete",
        "url": "https://dance-sheath-shindig.ngrok-free.dev/slack/events",
        "description": "Delete your messages from the last N hours",
        "usage_hint": "[hours]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://dance-sheath-shindig.ngrok-free.dev/slack/oauth_redirect"
    ],
    "scopes": {
      "bot": [
        "commands",
        "chat:write"
      ],
      "user": [
        "chat:write",
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://dance-sheath-shindig.ngrok-free.dev/slack/events"
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
