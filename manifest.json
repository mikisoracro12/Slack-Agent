{
  "display_information": {
    "name": "Auto Delete Messages",
    "description": "Deletes channel and DM messages after a delay unless they start with !!!",
    "background_color": "#2c2d30"
  },
  "features": {
    "bot_user": {
      "display_name": "Auto Delete",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:history",
        "groups:history",
        "chat:write"
      ],
      "user": [
        "chat:write",
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.channels",
        "message.groups"
      ],
      "user_events": [
        "message.im",
        "message.mpim"
      ]
    },
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
