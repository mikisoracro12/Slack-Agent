# Bot token (xoxb-) — OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-level token (xapp-) — Basic Information → App-Level Tokens
# Needs the connections:write scope for Socket Mode
SLACK_APP_TOKEN=xapp-your-app-token

# Workspace admin user token (xoxp-) — OAuth & Permissions → User OAuth Token
# Used for chat.delete on other users' messages (bot tokens cannot do this)
SLACK_ADMIN_USER_TOKEN=xoxp-your-user-token

# Seconds to wait before deleting a message (default 3600 = 1 hour)
# Use a small value like 60 while testing
DELETE_AFTER_SECONDS=3600
